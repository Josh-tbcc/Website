---
// Soft beige rounded hero used on inner pages
interface Props { eyebrow: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---
<section class="page-hero-wrap">
  <div class="panel page-hero">
    <div class="container page-hero__inner">
      <div class="page-hero__copy reveal">
        <span class="eyebrow">{eyebrow}</span>
        <h1 set:html={title} />
        {lead && <p class="lead">{lead}</p>}
        <slot name="actions" />
      </div>
      {Astro.slots.has('aside') && <div class="page-hero__aside reveal reveal-delay-2"><slot name="aside" /></div>}
    </div>
  </div>
</section>
<style>
  .page-hero-wrap { padding-top: 12px; }
  .page-hero {
    background:
      radial-gradient(60% 80% at 100% 0%, rgba(255,255,255,.7), transparent 60%),
      radial-gradient(50% 70% at 0% 100%, rgba(207,227,194,.45), transparent 60%),
      var(--sand);
    padding: clamp(64px, 9vw, 120px) 0 clamp(56px, 7vw, 96px);
  }
  .page-hero h1 { font-size: clamp(2.4rem, 5.2vw, 4rem); }
  .page-hero__aside :global(.media) { box-shadow: var(--shadow); }
  .page-hero__inner { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .page-hero__inner:not(:has(.page-hero__aside)) { grid-template-columns: 1fr; }
  .page-hero__copy { max-width: 760px; }
  @media (max-width: 960px) { .page-hero__inner { grid-template-columns: 1fr; } }
</style>
