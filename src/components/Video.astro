---
// Plays a video hosted on this site (public/videos/<name>.mp4 + .jpg cover,
// optional .vtt captions), or a YouTube video by ID. Falls back to a photo,
// then to a labelled placeholder.
import fs from 'node:fs';
import path from 'node:path';
import Icon from './Icon.astro';

interface Props {
  /** local video name in public/videos, e.g. "thermpix-benefits" */
  file?: string;
  /** YouTube video ID */
  id?: string;
  title: string;
  label?: string;
  /** phone-shaped (9:16) frame for reels */
  vertical?: boolean;
  /** silent looping background video (music-only reels) */
  ambient?: boolean;
  fallback?: string;
  fallbackAlt?: string;
  position?: string;
}
const { file, id, title, label, vertical = false, ambient = false, fallback, fallbackAlt, position = 'center' } = Astro.props;
const pub = (p: string) => fs.existsSync(path.join(process.cwd(), 'public', p));
const hasFile = !!file && pub(`/videos/${file}.mp4`);
const poster = hasFile && pub(`/videos/${file}.jpg`) ? `/videos/${file}.jpg` : undefined;
const captions = hasFile && pub(`/videos/${file}.vtt`) ? `/videos/${file}.vtt` : undefined;
const hasFallback = !!fallback && pub(fallback);
const cls = ['media', vertical ? 'media--vertical' : 'media--wide', 'video'].join(' ');
---
<div class={cls}>
  {hasFile ? (
    ambient
      ? <video src={`/videos/${file}.mp4`} poster={poster} autoplay muted loop playsinline preload="metadata" aria-label={title}></video>
      : <video src={`/videos/${file}.mp4`} poster={poster} controls playsinline preload="none" aria-label={title}>
          {captions && <track kind="captions" src={captions} srclang="en" label="English" default />}
        </video>
  ) : id ? (
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${id}?rel=0&modestbranding=1`}
      title={title}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
      style="width:100%;height:100%;border:0"></iframe>
  ) : hasFallback ? (
    <img src={fallback} alt={fallbackAlt ?? title} loading="lazy" decoding="async" style={`object-position:${position}`} />
  ) : (
    <>
      <span class="media__play"><Icon name="play" /></span>
      <span class="media__label">{label ?? title}<small>Add the video to public/videos</small></span>
    </>
  )}
</div>
