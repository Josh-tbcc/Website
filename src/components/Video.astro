---
// YouTube embed (privacy-enhanced). Until a video ID is set, shows the
// fallback photo if given, otherwise a labelled placeholder.
import fs from 'node:fs';
import path from 'node:path';
import Icon from './Icon.astro';
interface Props { id?: string; title: string; label?: string; fallback?: string; fallbackAlt?: string; position?: string }
const { id, title, label, fallback, fallbackAlt, position = 'center' } = Astro.props;
const hasFallback = !!fallback && fs.existsSync(path.join(process.cwd(), 'public', fallback));
---
<div class="media media--wide video">
  {id
    ? <iframe
        src={`https://www.youtube-nocookie.com/embed/${id}?rel=0&modestbranding=1`}
        title={title}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        style="width:100%;height:100%;border:0"></iframe>
    : hasFallback
      ? <img src={fallback} alt={fallbackAlt ?? title} loading="lazy" decoding="async" style={`object-position:${position}`} />
      : <>
          <span class="media__play"><Icon name="play" /></span>
          <span class="media__label">{label ?? title}<small>Add the YouTube ID in src/config/site.ts</small></span>
        </>}
</div>
