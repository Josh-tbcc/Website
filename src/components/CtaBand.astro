---
import BookButton from './BookButton.astro';
import Icon from './Icon.astro';
import { site } from '../config/site';
interface Props { title?: string; text?: string }
const {
  title = 'Ready to find out what’s really going on?',
  text = 'Book your new patient consultation online in under a minute, or give the team a call.',
} = Astro.props;
---
<section class="section--tight">
  <div class="panel cta">
    <div class="container cta__inner reveal">
      <div>
        <span class="eyebrow">Start here</span>
        <h2>{title}</h2>
        <p class="lead">{text}</p>
      </div>
      <div class="btn-row">
        <BookButton label="Book your first visit" />
        <a class="btn btn--glass" href={`tel:${site.phone.replace(/\s/g, '')}`}><Icon name="phone" />{site.phone}</a>
      </div>
    </div>
  </div>
</section>
<style>
  .cta {
    background:
      radial-gradient(60% 120% at 100% 0%, rgba(255,255,255,.65), transparent 60%),
      radial-gradient(50% 100% at 0% 100%, rgba(207,227,194,.5), transparent 60%),
      var(--sand);
    padding: clamp(56px, 8vw, 104px) 0;
  }
  .cta h2 { max-width: 720px; }
  .cta .lead { max-width: 560px; margin-bottom: 0; }
  .cta__inner { display: flex; justify-content: space-between; align-items: end; gap: 32px; flex-wrap: wrap; }
</style>
