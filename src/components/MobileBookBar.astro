---
import { site } from '../config/site';
import Icon from './Icon.astro';
---
<div class="mbar">
  <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="mbar__call" aria-label="Call us"><Icon name="phone" /></a>
  <a href="/book-online-yandina" class="mbar__book" data-book>Book online<Icon name="arrow" /></a>
</div>
<style>
  .mbar { display: none; }
  @media (max-width: 700px) {
    .mbar { display: flex; gap: 8px; position: fixed; bottom: 12px; left: 12px; right: 12px; z-index: 60; padding: 6px; border-radius: 999px; background: rgba(255,255,255,.94); backdrop-filter: blur(12px); border: 1px solid var(--line); box-shadow: 0 12px 30px -10px rgba(60,45,30,.3); }
    .mbar a { display: flex; align-items: center; justify-content: center; gap: 8px; border-radius: 999px; font-family: var(--font-head); font-weight: 700; text-decoration: none; }
    .mbar :global(svg) { width: 18px; height: 18px; }
    .mbar__call { width: 50px; height: 50px; flex-shrink: 0; background: var(--sand); color: var(--ink); }
    .mbar__book { flex: 1; background: var(--accent); color: var(--ink); }
    :global(body) { padding-bottom: 80px; }
  }
</style>
