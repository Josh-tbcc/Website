---
import fs from 'node:fs';
import path from 'node:path';
import { site } from '../config/site';
import BookButton from './BookButton.astro';
import Icon from './Icon.astro';

interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
type NavItem = { href: string; label: string; children?: { href: string; label: string }[] };
const nav: NavItem[] = [
  { href: '/new-patients', label: 'New Patients' },
  { href: '/thermography', label: 'Scans & X-Ray', children: [
    { href: '/thermography', label: 'Thermal Scan' },
    { href: '/in-house-x-ray', label: 'In-House X-Ray' },
  ] },
  { href: '/who-we-help', label: 'Who We Help' },
  { href: '/wellness-workshops', label: 'Workshops' },
  { href: '/blog', label: 'Education Centre' },
  { href: '/about', label: 'About' },
  { href: '/contact-us', label: 'Contact' },
];
const current = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => current === href || current.startsWith(href + '/');
const logo = ['logo-header.webp', 'logo.svg', 'logo.webp', 'logo.png'].find((f) => fs.existsSync(path.join(process.cwd(), 'public/images', f)));
const tel = `tel:${site.phone.replace(/\s/g, '')}`;
---
<header class:list={['site-header', { 'site-header--overlay': overlay }]} data-header>
  <div class="site-header__bar">
    <a href="/" class="brand" aria-label={`${site.name}, home`}>
      {logo
        ? <img class="brand__logo" src={`/images/${logo}`} alt={site.name} width="140" height="58" />
        : <span class="brand__mark">B</span><span class="brand__text">The Balanced<br /><strong>Chiropractic Centre</strong></span>}
    </a>
    <nav class="nav" aria-label="Main">
      <ul id="nav-list">
        {nav.map((n) => n.children ? (
          <li class="has-sub">
            <button type="button" class="sub-toggle" aria-expanded="false" aria-current={n.children.some((c) => isCurrent(c.href)) ? 'page' : undefined}>
              {n.label}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <ul class="sub">
              {n.children.map((c) => <li><a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>{c.label}</a></li>)}
            </ul>
          </li>
        ) : (
          <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
        <li class="nav__mobile-extra"><a href={tel}>Call {site.phone}</a></li>
      </ul>
    </nav>
    <div class="site-header__cta">
      <a href={tel} class="call" aria-label={`Call ${site.phone}`}><Icon name="phone" /></a>
      <BookButton />
      <button class="menu-toggle" aria-controls="nav-list" aria-expanded="false" aria-label="Open menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; padding: 12px 12px 0; transition: padding .3s var(--ease); }
  .site-header--overlay { position: fixed; left: 0; right: 0; }
  .site-header__bar {
    max-width: var(--max); margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 6px 10px 6px 22px; border-radius: 999px;
    background: rgba(255,255,255,.82); backdrop-filter: saturate(1.6) blur(16px); -webkit-backdrop-filter: saturate(1.6) blur(16px);
    border: 1px solid rgba(60,45,30,.08);
    box-shadow: 0 8px 30px -14px rgba(60,45,30,.22);
    transition: background .3s, box-shadow .3s, border-color .3s;
  }
  .site-header--overlay:not(.is-scrolled) .site-header__bar { background: rgba(255,255,255,.92); }

  .brand__logo { height: 58px; width: auto; }
  @media (max-width: 520px) { .brand__logo { height: 48px; } }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); line-height: 1.05; flex-shrink: 0; }
  .brand__mark { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; background: var(--ink); color: var(--mint); font-family: var(--font-head); font-weight: 800; font-size: 1.15rem; }
  .brand__text { font-family: var(--font-head); font-size: .8rem; font-weight: 500; letter-spacing: -0.01em; }
  .brand__text strong { font-size: .95rem; font-weight: 800; }

  .nav ul { list-style: none; display: flex; gap: 4px; margin: 0; padding: 0; }
  .nav a { display: block; padding: 9px 13px; border-radius: 999px; text-decoration: none; color: var(--ink); font-weight: 600; font-size: .92rem; white-space: nowrap; transition: background .2s, color .2s; }
  .nav a:hover { background: var(--sand); }
  .nav a[aria-current='page'] { background: var(--mint-soft); color: var(--brand-dark); }
  .nav__mobile-extra { display: none; }

  /* Dropdown (Scans & X-Ray) */
  .has-sub { position: relative; }
  .sub-toggle { display: flex; align-items: center; gap: 4px; padding: 9px 13px; border-radius: 999px; border: 0; background: none; font: inherit; color: var(--ink); font-weight: 600; font-size: .92rem; white-space: nowrap; cursor: pointer; transition: background .2s, color .2s; }
  .sub-toggle svg { width: 14px; height: 14px; transition: transform .2s; }
  .sub-toggle:hover { background: var(--sand); }
  .sub-toggle[aria-current='page'] { background: var(--mint-soft); color: var(--brand-dark); }
  .nav .sub { position: absolute; top: calc(100% + 6px); left: 0; min-width: 200px; flex-direction: column; gap: 2px; padding: 8px; background: var(--white); border-radius: 18px; box-shadow: var(--shadow); display: none; z-index: 5; }
  .nav .sub::before { content: ''; position: absolute; left: 0; right: 0; top: -8px; height: 8px; }
  .has-sub:hover .sub, .has-sub:focus-within .sub, .has-sub.open .sub { display: flex; }
  .has-sub:hover .sub-toggle svg, .has-sub.open .sub-toggle svg { transform: rotate(180deg); }

  .site-header__cta { display: flex; align-items: center; gap: 8px; }
  .site-header__cta :global(.btn) { padding: .85em 1.3em; font-size: .92rem; }
  .call { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; color: var(--ink); border: 1px solid rgba(127,127,127,.25); }
  .call :global(svg) { width: 18px; height: 18px; }

  .menu-toggle { display: none; width: 44px; height: 44px; border-radius: 50%; background: none; border: 1px solid rgba(127,127,127,.25); cursor: pointer; position: relative; }
  .menu-toggle span { position: absolute; left: 13px; right: 13px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform .3s var(--ease), top .3s var(--ease); }
  .menu-toggle span:first-child { top: 17px; }
  .menu-toggle span:last-child { top: 25px; }
  .menu-toggle[aria-expanded='true'] span:first-child { top: 21px; transform: rotate(45deg); }
  .menu-toggle[aria-expanded='true'] span:last-child { top: 21px; transform: rotate(-45deg); }

  @media (max-width: 1300px) {
    .menu-toggle { display: block; }
    .call { display: none; }
    .nav ul {
      display: none; position: absolute; top: calc(100% + 8px); left: 12px; right: 12px;
      flex-direction: column; gap: 2px; padding: 12px;
      background: var(--white); border-radius: 24px; box-shadow: var(--shadow);
    }
    .nav ul.open { display: flex; }
    .nav li a, .sub-toggle { color: var(--ink); padding: 14px 16px; font-size: 1.05rem; }
    .nav__mobile-extra { display: block; }
    .sub-toggle { width: 100%; justify-content: space-between; }
    .nav .sub { position: static; display: flex; box-shadow: none; padding: 0 0 4px 16px; min-width: 0; }
    .nav .sub a { font-size: .98rem; padding: 10px 16px; color: var(--text); }
    .sub-toggle svg { display: none; }
  }
  @media (max-width: 520px) {
    .site-header__cta :global(.btn) { display: none; }
    .brand__text { font-size: .72rem; } .brand__text strong { font-size: .85rem; }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const btn = document.querySelector('.menu-toggle');
  const list = document.getElementById('nav-list');
  btn?.addEventListener('click', () => {
    const open = list?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
    header?.classList.toggle('is-scrolled', !!open || scrollY > 40);
  });
  // Dropdown: tap to open on touch screens, close when clicking elsewhere
  document.querySelectorAll<HTMLElement>('.has-sub').forEach((item) => {
    const t = item.querySelector('.sub-toggle');
    t?.addEventListener('click', () => {
      const open = item.classList.toggle('open');
      t.setAttribute('aria-expanded', String(open));
    });
  });
  document.addEventListener('click', (e) => {
    document.querySelectorAll('.has-sub.open').forEach((item) => {
      if (!item.contains(e.target as Node)) { item.classList.remove('open'); item.querySelector('.sub-toggle')?.setAttribute('aria-expanded', 'false'); }
    });
  });
  const onScroll = () => header?.classList.toggle('is-scrolled', scrollY > 40 || !!list?.classList.contains('open'));
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
