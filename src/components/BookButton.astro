---
import Icon from './Icon.astro';
interface Props { label?: string; variant?: 'primary' | 'ghost' | 'light' | 'dark' | 'glass'; block?: boolean }
const { label = 'Book Online', variant = 'primary', block = false } = Astro.props;
---
<a href="/book-online-yandina" class={`btn btn--${variant}${block ? ' btn--block' : ''}`} data-book>{label}<Icon name="arrow" /></a>
