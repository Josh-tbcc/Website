---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Video from '../components/Video.astro';
import BookButton from '../components/BookButton.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
---
<Base title="Thermography Nerve Scan" description="Thermpix thermal imaging with AI-assisted analysis at The Balanced Chiropractic Centre, Yandina. An objective look at where your nervous system is under stress.">
  <PageHero eyebrow="Thermography nerve scan" title="Clarity starts with <span class='hl'>measurement.</span>" lead="Thermography imaging identifies specific hotspots on your body and spine. It gives us an objective indication of which areas need attention, so your care is based on data, not guesswork.">
    <div class="btn-row" slot="actions"><BookButton label="Book a consult & scan" /></div>
    <div slot="aside"><Video id={site.videos.thermography} title="Thermography scan at The Balanced Chiropractic Centre" label="Thermography scan video" /></div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="center narrow">
        <span class="eyebrow">How it works</span>
        <h2>Fast, painless and non-invasive</h2>
      </div>
      <div class="grid grid-3" style="margin-top:36px">
        <div class="card card--hover reveal">
          <div class="icon"><Icon name="scan" /></div>
          <h3>Thermal imaging</h3>
          <p>Our Thermpix camera captures detailed thermal images of your spine and body. Nothing touches you and there’s no radiation.</p>
        </div>
        <div class="card card--hover reveal">
          <div class="icon"><Icon name="sparkle" /></div>
          <h3>AI-assisted analysis</h3>
          <p>Integrated AI analysis highlights temperature patterns and asymmetries, helping us spot hotspots that suggest areas of stress and irritation.</p>
        </div>
        <div class="card card--hover reveal">
          <div class="icon"><Icon name="chart" /></div>
          <h3>Your roadmap</h3>
          <p>We combine your scan with your history, exam and X-rays (if needed) to pinpoint the areas to focus on, and show you the results in your report of findings.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--cream panel">
    <div class="container split">
      <Media src="/images/thermography-scan.jpg" alt="Example thermography scan image, patient details removed" label="Example Thermpix scan image (de-identified)" />
      <div>
        <span class="eyebrow">Why it matters</span>
        <h2>Pain tells you something’s wrong. The scan helps show where.</h2>
        <p>Symptoms are often the last thing to appear and the first to disappear. An area can be under stress long before it hurts, and can still be under stress after the pain eases.</p>
        <p>That’s why we scan at the start of care and re-scan as you progress. It lets us compare results over time and make sure your care is doing what it should, well beyond the point where you simply feel better.</p>
        <ul class="checklist">
          <li>Objective starting point for your care</li>
          <li>Progress you can see, not just feel</li>
          <li>Helps guide exactly where we adjust</li>
          <li>Safe for all ages, including kids and during pregnancy</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <p class="fine-print">Thermography is one part of our comprehensive chiropractic assessment and is interpreted together with your history, physical examination and any imaging. It is not a stand-alone diagnostic test and does not replace medical assessment.</p>
    </div>
  </section>

  <CtaBand title="Find out what your scan shows" />
</Base>
