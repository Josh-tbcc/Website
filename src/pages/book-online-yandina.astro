---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import PageHero from '../components/PageHero.astro';
const { embedCode, url, embed, newPatientLabel } = site.booking;
---
<Base title="Book Online Yandina" description="Book your chiropractor appointment online at The Balanced Chiropractic Centre, Yandina. New patient consultations and existing practice member appointments, Sunshine Coast.">
  <PageHero eyebrow="Book online" title="Choose a time <span class='hl'>that suits you.</span>">
    <div slot="actions" class="book-tips">
      <div><strong>New here?</strong><span>Select “{newPatientLabel}”</span></div>
      <div><strong>Existing practice member?</strong><span>Choose your regular appointment</span></div>
    </div>
  </PageHero>
  <section class="section" style="padding-top:32px">
    <div class="container">
      {embedCode ? (
        <div class="booking-embed" set:html={embedCode} />
      ) : url ? (
        embed ? (
          <>
            <div class="booking-frame"><iframe src={url} title="Online booking" loading="eager"></iframe></div>
            <p class="center fine-print" style="margin-top:14px">Booking not loading? <a href={url} target="_blank" rel="noopener">Open the booking page in a new tab</a> or call <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>.</p>
          </>
        ) : (
          <div class="center"><a class="btn btn--primary" href={url} target="_blank" rel="noopener" data-book>Open online booking</a></div>
        )
      ) : (
        <div class="card center narrow">
          <h2>Online booking coming soon</h2>
          <p>(Add the Zurili embed code in src/config/site.ts.)</p>
          <p>In the meantime, call us on <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>.</p>
        </div>
      )}
    </div>
  </section>
</Base>
<style>
  .book-tips { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; max-width: 640px; }
  .book-tips div { padding: 16px 18px; border-radius: 16px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); }
  .book-tips strong { display: block; color: var(--white); }
  .book-tips span { font-size: .92rem; }
  @media (max-width: 560px) { .book-tips { grid-template-columns: 1fr; } }
  .booking-embed { min-height: 700px; }
  .booking-embed :global(iframe) { width: 100%; min-height: 900px; border: 0; }
  .booking-frame { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); }
  .booking-frame iframe { width: 100%; height: 900px; border: 0; }
</style>
