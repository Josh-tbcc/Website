---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Video from '../components/Video.astro';
import BookButton from '../components/BookButton.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { publishedPosts, formatDate } from '../utils/posts';
import SwipeCall from '../components/SwipeCall.astro';
const latestPosts = (await publishedPosts()).slice(0, 3);

const conditions = [
  ['Lower back pain', '/back-pain'], ['Neck pain', '/neck-pain'], ['Headaches', '/headaches'], ['Sciatica', '/sciatica'],
  ['Shoulder pain', '/shoulder-pain'], ['Knee pain', '/knee-pain'], ['Upper back pain', '/mid-back-pain'], ['Hip pain', '/hip-pain'],
  ['Posture', '/poor-posture'], ['Chronic pain', '/chronic-pain'], ['Pregnancy', '/pregnancy-chiropractic'], ['Whiplash', '/whiplash'],
  ['Arthritis', '/arthritis'], ['Jaw pain', '/jaw-pain'], ['Stress & tension', '/stress'], ['Kids & families', '/who-we-help#families'],
  ['Sports', '/sports-chiropractic'],
];
const a = site.address;
// Plain, factual answers that Google and AI assistants can quote directly
const homeFaqs = [
  ['Where can I find a chiropractor near me on the Sunshine Coast?', `The Balanced Chiropractic Centre is a family chiropractic clinic at ${a.street}, ${a.suburb} ${a.state}, looking after families from Yandina and the surrounding suburbs. Every new patient has a thorough assessment including a Thermpix thermography scan, and in-house X-ray if clinically required, followed by a clear report of findings.`],
  ['Can a chiropractor help with lower back pain, neck pain and headaches?', 'Lower back pain, neck pain and tension-type or neck-related headaches are among the most common reasons people see us. We assess how your spine is moving and how your nervous system is adapting, then build a staged plan around your goals. Individual results vary.'],
  ['What happens at my first visit?', 'Your first visit is a 30-minute comprehensive assessment: health history, thermography scan, spinal and neurological tests, and X-rays on site if clinically required. On your second visit we explain your results and recommendations in plain English.'],
  ['How do I choose a good chiropractor near me?', 'Look for a chiropractor who is registered with AHPRA, takes a full health history, examines you properly before treating, explains what they find and the plan in plain English, checks your progress along the way, and refers you on if something needs a different approach. That is how we work at The Balanced Chiropractic Centre in Yandina.'],
  ['Is there a chiropractor near Nambour, Eumundi or Bli Bli?', `Yes. Our clinic in ${a.suburb} is about 10 minutes from Nambour, 10 to 15 minutes from Eumundi and about 15 minutes from Bli Bli. Yandina Station is a short walk away.`],
  ['Is there a chiropractor open early or after work near Yandina?', 'Yes. We open from 7am on Tuesday, Thursday and Friday mornings, and until 6pm Monday to Thursday afternoons, so you can come before or after work or school.'],
  ['Which areas do you serve?', 'Yandina and the surrounding suburbs across the Sunshine Coast hinterland, including Yandina Creek, Nambour, Kulangoor, North Arm, Ninderry, Valdora, Eumundi, Bli Bli, Pacific Paradise, Cooroy and Coolum Beach.'],
  ['Do I need a referral to see a chiropractor?', `No. You can book online or call ${site.phone}. Our chiropractors are Dr Joshua Kassis and Dr David Rowan.`],
];
const who = [
  { icon: 'users', title: 'Families & kids', text: 'Gentle, age-appropriate care from little ones to grandparents.', href: '/who-we-help#families' },
  { icon: 'heart', title: 'Pregnancy', text: 'Support for your changing body through every trimester.', href: '/who-we-help#pregnancy' },
  { icon: 'activity', title: 'Sports & athletes', text: 'Move better, recover well and keep training consistently.', href: '/who-we-help#athletes' },
  { icon: 'spine', title: 'Ongoing issues', text: 'For the back, neck and headaches that keep coming back.', href: '/who-we-help#chronic' },
];
---
<Base overlayHeader schema={{ '@type': 'FAQPage', mainEntity: homeFaqs.map(([q, ans]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: ans } })) }}>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy reveal">
        <span class="eyebrow">Chiropractor · Yandina</span>
        <h1>We don’t guess.<br /><span class="hl">We measure.</span></h1>
        <p class="lead">
          Thermal nerve scans, in-house X-ray and a thorough exam to find the pattern behind your symptoms,
          then a clear plan to change it for good.
        </p>
        <div class="btn-row">
          <BookButton label="Book your first visit" />
          <SwipeCall />
          <a class="btn btn--glass" href="/new-patients">What to expect</a>
        </div>
      </div>
      <div class="stats hero__stats reveal reveal-delay-2">
        <div class="stat"><strong>2 visits</strong><span>to clear answers and a plan</span></div>
        <div class="stat"><strong>AI thermal scan</strong><span>Thermpix nerve imaging</span></div>
        <div class="stat"><strong>Milestone checks</strong><span>progress re-measured along the way</span></div>
      </div>
      <div class="hero__visual reveal reveal-delay-1">
        <Media src="/images/hero.jpg" alt="Dr Josh taking a ThermPix thermal scan of a patient’s spine" label="Hero photo" shape="tall" eager class="hero__photo" />
        <div class="hero__badge">
          <span class="hero__badge-icon"><Icon name="scan" /></span>
          <span><strong>Measured, not guessed</strong>Scan, exam &amp; X-ray if needed</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CONDITIONS RIBBON -->
  <div class="marquee" aria-label="Conditions we help with">
    <div class="marquee__track">
      {[...conditions, ...conditions].map(([label, href], i) => <a href={href} tabindex={i >= conditions.length ? -1 : undefined} aria-hidden={i >= conditions.length ? 'true' : undefined}><span>{label}</span></a>)}
    </div>
  </div>

  <!-- THE PROBLEM -->
  <section class="section">
    <div class="container split">
      <div class="reveal">
        <span class="eyebrow">Sound familiar?</span>
        <h2>It settles… then it comes <span class="hl">straight back.</span></h2>
      </div>
      <div class="reveal reveal-delay-1">
        <p class="lead">
          If you’ve been stretching, booking massages or working on your posture, good on you. You’ve been taking your
          health seriously, and that matters.
        </p>
        <p>When the same neck, lower back or headaches keep coming back, it’s usually because the underlying cause was never found. That’s where we start: measuring what’s really going on, so your care can address the cause and build lasting change step by step.</p>
      </div>
    </div>
  </section>

  <!-- APPROACH: BENTO -->
  <section class="section section--cream panel">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">Our approach</span>
          <h2>Care that’s built to last</h2>
        </div>
        <p>Feeling better is the start. Staying better is the goal. Every plan moves through three clear phases, and we re-measure so you can see the change, not just feel it.</p>
      </div>
      <div class="bento">
        <div class="card bento__a reveal">
          <span class="num">PHASE 01</span>
          <h3>Relief</h3>
          <p>We calm things down and get you moving again, focusing on the areas your scans and exam show are under the most stress.</p>
        </div>
        <div class="card bento__b reveal reveal-delay-1">
          <span class="num">PHASE 02</span>
          <h3>Correction</h3>
          <p>Once we’ve helped ease your symptoms, we work on the underlying pattern: restoring motion, improving how your spine carries load and how your nervous system adapts.</p>
        </div>
        <div class="card bento__c reveal reveal-delay-2">
          <span class="num">PHASE 03</span>
          <h3>Strength & wellness</h3>
          <p>To help your progress last and keep your body strong, we use specific corrective exercises, home care and regular check-ins, so your symptoms are less likely to return.</p>
          <div class="progress" aria-hidden="true"><span></span><span></span><span></span></div>
        </div>
        <Media src="/images/treatment-room.jpg" alt="Treatment room at The Balanced Chiropractic Centre" label="Treatment room photo" class="bento__img reveal" />
        <Media src="/images/phase3-checkup.jpg" alt="Dr David checking a patient’s leg length and balance at a progress check" label="Phase 3 photo" class="bento__img2 reveal reveal-delay-2" />
      </div>
    </div>
  </section>

  <!-- THERMOGRAPHY -->
  <section class="section">
    <div class="container video-split video-split--flip">
      <div class="reveal">
        <Video file={site.videos.thermography} vertical title="Dr Josh explains the ThermPix inflammation scanner" />
      </div>
      <div class="reveal reveal-delay-1">
        <span class="eyebrow">Thermography nerve scan</span>
        <h2>See what’s happening <span class="hl">beneath the surface</span></h2>
        <p class="lead">Thermpix thermal imaging with AI-assisted analysis identifies hotspots along your spine, an objective picture of where your nervous system is under stress.</p>
        <ul class="feature-list">
          <li><Icon name="scan" /><div><strong>Non-invasive and painless</strong><span>Nothing touches you and there’s no radiation</span></div></li>
          <li><Icon name="chart" /><div><strong>Progress you can see</strong><span>We re-scan and compare as your care progresses</span></div></li>
          <li><Icon name="xray" /><div><strong><a href="/in-house-x-ray">In-house X-ray</a></strong><span>With motion studies when clinically required</span></div></li>
        </ul>
        <a class="btn btn--ghost" href="/thermography">How the scan works<Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- NEW PATIENT STEPS -->
  <section class="section">
    <div class="container split" style="align-items:start">
      <div class="sticky-col reveal">
        <span class="eyebrow">New patients</span>
        <h2>Two visits to real answers</h2>
        <p class="lead">We take the time to carefully and fully assess your spine, gathering everything needed to understand your concern and the right solution for you. Then we walk you through it.</p>
        <div class="btn-row">
          <BookButton label="Book new patient consult" />
          <SwipeCall />
          <a class="btn btn--ghost" href="/new-patients">Learn more</a>
        </div>
      </div>
      <div class="steps">
        <div class="step reveal">
          <h3>Comprehensive assessment</h3>
          <p>Full health history, thermography scan, spinal palpation, neurological tests and, if needed, in-house X-rays with motion to pinpoint the areas of restriction.</p>
        </div>
        <div class="step reveal reveal-delay-1">
          <h3>Report of findings</h3>
          <p>We sit down and walk you through your results: what’s going on, why it matters, and the path to correct it long term.</p>
        </div>
        <div class="step reveal reveal-delay-2">
          <h3>Your care plan begins</h3>
          <p>A clear, personalised plan with progress checks at milestones set for your individual case, so you always know where you’re at.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WELCOME VIDEO -->
  <section class="section section--tight">
    <div class="container" style="max-width:880px">
      <div class="center reveal">
        <span class="eyebrow">Watch before you visit</span>
        <h2>What to expect at your first visit</h2>
      </div>
      <div class="reveal" style="margin-top:24px"><Video file={site.videos.welcome} title="Welcome from Dr Josh: what to expect at your first visit" /></div>
    </div>
  </section>

  <!-- WHO WE HELP -->
  <section class="section section--mint panel">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">Who we help</span>
          <h2>Care for every stage of life</h2>
        </div>
        <a class="btn btn--dark" href="/who-we-help">See who we help<Icon name="arrow" /></a>
      </div>
      <div class="grid grid-4">
        {who.map((w, i) => (
          <a class={`card card--hover who reveal reveal-delay-${i}`} href={w.href}>
            <div class="icon"><Icon name={w.icon} /></div>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
            <span class="who__more">Learn more <Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- TEAM -->
  <section class="section">
    <div class="container video-split video-split--flip">
      <div class="reveal"><Video file={site.videos.thorough} vertical title="Dr Josh on how we investigate and plan your care" /></div>
      <div class="reveal reveal-delay-1">
        <span class="eyebrow">Meet the team</span>
        <h2>A family practice for the Yandina community</h2>
        <p class="lead">Led by Dr Joshua Kassis, our team believes the body is designed to heal and thrive when the spine and nervous system are working well.</p>
        <p>We’re here to help you understand your health, not just treat your symptoms, and to support you every step of the way.</p>
        <div class="btn-row">
          <a class="btn btn--dark" href="/about">About us<Icon name="arrow" /></a>
          {site.social.googleReviews && <a class="btn btn--ghost" href={site.social.googleReviews} target="_blank" rel="noopener">Read our Google reviews</a>}
        </div>
      </div>
    </div>
  </section>

  <!-- BLOG -->
  {latestPosts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head reveal">
          <div>
            <span class="eyebrow">From the blog</span>
            <h2>Health tips from your local chiropractors</h2>
          </div>
          <a class="btn btn--dark" href="/blog">All articles<Icon name="arrow" /></a>
        </div>
        <div class="grid grid-3">
          {latestPosts.map((p, i) => (
            <a class={`card card--hover blogcard reveal reveal-delay-${i}`} href={`/blog/${p.id}/`}>
              <span class="blogcard__date">{formatDate(p.data.date)}</span>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="section section--cream panel">
    <div class="container narrow">
      <div class="center">
        <span class="eyebrow">Questions</span>
        <h2>Chiropractor in Yandina</h2>
      </div>
      <div style="margin-top:24px">
        {homeFaqs.map(([q, ans]) => <details class="faq"><summary>{q}</summary><p>{ans}</p></details>)}
      </div>
      <p class="center" style="margin-top:24px"><a href="/areas-we-serve">Areas we serve</a></p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Hero */
  .hero {
    margin: 0 12px; border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    background:
      radial-gradient(55% 70% at 100% 0%, rgba(255,255,255,.75), transparent 60%),
      radial-gradient(45% 60% at 0% 100%, rgba(207,227,194,.5), transparent 60%),
      var(--sand);
  }
  .hero__inner { padding-top: 150px; padding-bottom: clamp(48px, 6vw, 88px); display: grid; grid-template-columns: 1.1fr .9fr; grid-template-areas: 'copy visual' 'stats visual'; gap: 0 clamp(32px, 5vw, 80px); align-items: center; }
  .hero__copy { grid-area: copy; align-self: end; }
  .hero__visual { grid-area: visual; }
  .hero__stats { grid-area: stats; align-self: start; }
  .hero h1 { font-size: clamp(3rem, 7vw, 5.8rem); margin-bottom: .35em; }
  .hero .lead { max-width: 540px; margin-bottom: 1.8em; }
  .hero__stats { margin-top: clamp(32px, 5vw, 56px); max-width: 620px; }
  .hero__visual { position: relative; }
  .hero :global(.hero__photo) { border-radius: 260px 260px var(--radius-lg) var(--radius-lg); box-shadow: var(--shadow); max-width: 520px; margin-left: auto; }
  .hero__badge {
    position: absolute; left: 0; bottom: 36px; display: flex; align-items: center; gap: 12px;
    background: rgba(255,255,255,.95); backdrop-filter: blur(10px); border-radius: 18px; padding: 12px 18px 12px 12px;
    box-shadow: var(--shadow); font-size: .82rem; color: var(--muted); line-height: 1.35;
  }
  .hero__badge strong { display: block; color: var(--ink); font-family: var(--font-head); font-size: .92rem; }
  .hero__badge-icon { width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; background: var(--mint); color: var(--brand-dark); flex-shrink: 0; }
  .hero__badge-icon :global(svg) { width: 20px; height: 20px; }
  @media (max-width: 900px) {
    .hero__inner { grid-template-columns: 1fr; grid-template-areas: 'copy' 'visual' 'stats'; row-gap: 32px; padding-top: 120px; }
    .hero__stats { margin-top: 0; }
    .hero :global(.hero__photo) { margin: 0 auto; max-width: 440px; }
    .hero__badge { left: 50%; transform: translateX(-50%); bottom: 20px; white-space: nowrap; }
  }

  /* Bento */
  .bento { display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: auto auto; gap: 20px; }
  .bento__a { grid-column: 1; grid-row: 1; }
  .bento__b { grid-column: 2; grid-row: 1; }
  .bento__c { grid-column: 3; grid-row: 1; display: flex; flex-direction: column; }
  .bento :global(.bento__img) { grid-column: 1 / span 2; grid-row: 2; aspect-ratio: auto; min-height: 320px; }
  .bento :global(.bento__img2) { grid-column: 3; grid-row: 2; aspect-ratio: auto; min-height: 320px; }
  .bento :global(.bento__img img), .bento :global(.bento__img2 img) { position: absolute; inset: 0; }
  .bento :global(.bento__img2 img) { object-position: 50% 30%; }
  .progress { display: flex; gap: 6px; margin-top: auto; padding-top: 32px; }
  .progress span { flex: 1; height: 6px; border-radius: 6px; background: var(--sand-2); }
  .progress span:last-child { background: var(--accent); }
  @media (max-width: 960px) {
    .bento { grid-template-columns: 1fr 1fr; }
    .bento > *, .bento :global(.bento__img), .bento :global(.bento__img2) { grid-row: auto !important; }
    .bento__c { grid-column: 1 / span 2; }
    .bento :global(.bento__img) { grid-column: 1; }
    .bento :global(.bento__img2) { grid-column: 2; }
  }
  @media (max-width: 620px) {
    .bento { grid-template-columns: 1fr; }
    .bento > *, .bento :global(.bento__img), .bento :global(.bento__img2) { grid-column: auto !important; }
    .hero__stats { grid-template-columns: repeat(3, 1fr); }
    .hero__stats .stat { padding: 14px 12px; }
    .hero__stats .stat strong { font-size: 1rem; }
    .hero__stats .stat span { font-size: .72rem; line-height: 1.35; display: block; margin-top: 4px; }
  }

  .feature-list { list-style: none; padding: 0; margin: 0 0 28px; display: grid; gap: 16px; }
  .feature-list li { display: flex; gap: 16px; align-items: flex-start; }
  .feature-list :global(svg) { flex-shrink: 0; width: 44px; height: 44px; padding: 11px; border-radius: 14px; background: var(--mint-soft); color: var(--brand); }
  .feature-list strong { display: block; color: var(--ink); font-family: var(--font-head); }
  .feature-list span { font-size: .95rem; color: var(--muted); }


  .sticky-col { position: sticky; top: 120px; }
  @media (max-width: 960px) { .sticky-col { position: static; } }

  .blogcard { text-decoration: none; color: inherit; }
  .blogcard h3 { margin: 10px 0 .4em; }
  .blogcard p { font-size: .95rem; color: var(--muted); margin: 0; }
  .blogcard__date { font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--brand); }
  .who { text-decoration: none; color: inherit; display: flex; flex-direction: column; }
  .who:hover { color: inherit; }
  .who__more { margin-top: auto; padding-top: 18px; display: inline-flex; align-items: center; gap: 6px; font-weight: 700; font-size: .9rem; color: var(--brand); }
  .who__more :global(svg) { width: 16px; height: 16px; transition: transform .25s var(--ease); }
  .who:hover .who__more :global(svg) { transform: translateX(4px); }
</style>
