---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Media from '../components/Media.astro';
import BookButton from '../components/BookButton.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import Video from '../components/Video.astro';
import { conditions, type Condition } from '../config/conditions';
import { site } from '../config/site';
import SwipeCall from '../components/SwipeCall.astro';

export function getStaticPaths() {
  return conditions.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: Condition };
const others = conditions.filter((o) => o.slug !== c.slug);
// How people phrase this condition when searching "chiropractor near me for …"
const topics: Record<string, string> = {
  'Chronic & ongoing pain': 'chronic pain', 'Upper & mid back pain': 'upper back pain', 'Whiplash & car accidents': 'whiplash',
  'Sports & active people': 'sports injuries', 'Jaw pain (TMJ)': 'jaw pain and TMJ', 'Poor posture': 'posture',
  'Stress & tension': 'stress and tension', 'Pregnancy': 'pregnancy care',
};
const topic = topics[c.name] ?? c.name.toLowerCase();
const a = site.address;
const openDays = site.hours.filter((h) => /\d/.test(h.time) && !/market/i.test(h.time)).map((h) => `${h.days} ${h.time}`).join('; ');
const localFaq = {
  q: `Is there a chiropractor near me for ${topic}?`,
  a: `Yes. The Balanced Chiropractic Centre is at ${a.street}, ${a.suburb} ${a.state} ${a.postcode} on the Sunshine Coast, about 10 minutes from Nambour and Eumundi. We see people for ${topic} from ${site.areaServed.filter((x) => x !== 'Sunshine Coast').join(', ')} and the wider Sunshine Coast. Opening hours: ${openDays}. No referral is needed: book online or call ${site.phone}.`,
};
const faqs = [...c.faqs, localFaq];
const pageUrl = new URL(Astro.url.pathname, site.url).href;
const schema = [
  {
    '@type': 'MedicalWebPage',
    name: c.metaTitle,
    url: pageUrl,
    description: c.metaDescription,
    inLanguage: 'en-AU',
    about: { '@type': 'MedicalCondition', name: c.name },
    reviewedBy: { '@id': `${site.url}/#dr-joshua-kassis` },
    lastReviewed: site.contentReviewed,
    publisher: { '@id': `${site.url}/#clinic` },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={c.metaTitle} description={c.metaDescription} crumb={c.name} image={c.photo} schema={schema}>

  <PageHero eyebrow={`${c.name} · Chiropractor Yandina`} title={c.h1} lead={c.intro}>
    <div class="btn-row" slot="actions">
      <BookButton label="Book a consultation" />
      <SwipeCall />
      <a class="btn btn--glass" href="/new-patients">What to expect</a>
    </div>
    <Media slot="aside" src={c.photo} alt={c.photoAlt} label={c.photoAlt} />
  </PageHero>

  <section class="section">
    <div class="container split" style="align-items:start">
      <div class="reveal">
        <span class="eyebrow">Sound familiar?</span>
        <h2>Common signs we see</h2>
        <ul class="checklist">
          {c.signs.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div class="reveal reveal-delay-1">
        <span class="eyebrow">Why it keeps returning</span>
        <h2>Looking beyond the symptom</h2>
        {c.why.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  {c.video && (
    <section class="section section--tight">
      <div class="container video-split video-split--flip">
        <Video file={c.video.file} vertical title={c.video.title} />
        <div class="reveal">
          <span class="eyebrow">Watch: Dr Josh explains</span>
          <h2>{c.video.title}</h2>
          <p class="lead">{c.video.blurb}</p>
        </div>
      </div>
    </section>
  )}

  <section class="section section--cream panel">
    <div class="container split">
      <div class="reveal">
        <span class="eyebrow">How we help</span>
        <h2>We measure first, then build your plan</h2>
        <p class="lead">Every new patient starts with a comprehensive assessment, followed by a report of findings where we explain exactly what we found and the path forward.</p>
        <div class="btn-row">
          <a class="btn btn--dark" href="/thermography">About the thermal scan<Icon name="arrow" /></a>
        </div>
      </div>
      <div class="steps">
        {c.focus.map((f, i) => (
          <div class={`step reveal reveal-delay-${Math.min(i, 3)}`}><p><strong>{f}</strong></p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2 class="center">{c.name}: common questions</h2>
      {faqs.map((f) => (
        <details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
      <p class="fine-print" style="margin-top:28px">Individual results vary. Your care is tailored to you following a thorough history and examination. If we find something that needs a different approach, we’ll refer you to the right health professional.</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <h2 style="font-size:1.5rem">Other conditions we help with</h2>
      <div class="other">
        {others.map((o) => <a href={`/${o.slug}`}>{o.name}</a>)}
      </div>
      <p class="fine-print" style="margin-top:20px">Our Yandina clinic sees people for {c.name.toLowerCase()} from Nambour, Yandina Creek, Kulangoor, North Arm, Eumundi, Bli Bli, Pacific Paradise, Cooroy, Coolum and across the Sunshine Coast. <a href="/areas-we-serve">See the areas we serve</a>.</p>
    </div>
  </section>

  <CtaBand title={/[&]|sports/i.test(c.name) ? 'Let’s find out what’s really going on' : `Let’s find out what’s behind your ${c.name.toLowerCase()}`} />
</Base>

<style>
  .step { padding-left: 84px; }
  .step p { margin: 0; }
  .other { display: flex; flex-wrap: wrap; gap: 10px; }
  .other a { padding: 10px 18px; border-radius: 999px; border: 1px solid var(--line); text-decoration: none; color: var(--ink); font-weight: 600; font-size: .95rem; transition: background .2s, border-color .2s; }
  .other a:hover { background: var(--mint-soft); border-color: transparent; color: var(--brand-dark); }
</style>
