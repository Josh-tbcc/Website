---
import Base from '../../layouts/Base.astro';
import Video from '../../components/Video.astro';
import { site } from '../../config/site';
---
<Base landing noindex title="Thank You">
  <section class="section section--mint">
    <div class="container narrow center">
      <span class="eyebrow">You’re in</span>
      <h1>Thanks! We’ll be in touch shortly.</h1>
      <p class="lead">One of our team will call you from <strong>{site.phone}</strong> to find a time for your assessment. Keep an eye on your phone. If you miss us, we’ll send a text.</p>
      <p>Can’t wait? Call us now on <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>.</p>
    </div>
  </section>
  <section class="section">
    <div class="container" style="max-width:880px">
      <h2 class="center">While you wait: see how our thermal scan works</h2>
      <Video id={site.videos.thermography} title="Thermography scan at The Balanced Chiropractic Centre" label="Thermography scan video" fallback="/images/thermal-back.jpg" fallbackAlt="Thermpix thermal image of a patient’s back" position="center 45%" />
    </div>
  </section>
</Base>
