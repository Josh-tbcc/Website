---
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import Video from '../../components/Video.astro';
import { site } from '../../config/site';
const { offer } = site;
---
<Base
  landing
  noindex
  title={`${offer.price} ${offer.name}`}
  description={`New patient ${offer.name} at The Balanced Chiropractic Centre, Yandina: thermography scan, spinal assessment and clear answers for ${offer.price}.`}
>
  <!-- HERO + FORM -->
  <section class="lp-hero">
    <div class="panel lp-hero__panel">
    <div class="container lp-grid">
      <div class="lp-copy">
        <span class="eyebrow">Yandina · Sunshine Coast</span>
        <h1>Back or neck pain that <span class="hl">keeps coming back?</span></h1>
        <p class="lead">It isn’t random, and it’s rarely just tight muscles. It’s a pattern your spine and nervous system have adapted to. Let’s measure what’s actually going on.</p>
        <div class="swipe" data-swipe role="button" tabindex="0" aria-haspopup="dialog" aria-controls="claim" aria-label={`Swipe or tap to claim your ${offer.price} new patient ${offer.name}`}>
          <span class="swipe__fill" aria-hidden="true"></span>
          <span class="swipe__text" aria-hidden="true"><strong>New patient {offer.name}</strong><small>Swipe to claim →</small></span>
          <span class="swipe__knob" aria-hidden="true">{offer.price}</span>
        </div>
        <ul class="checklist">
          {offer.includes.map((i) => <li>{i}</li>)}
        </ul>
      </div>

      <div class="lp-photo">
        <Media src="/images/np-consult.jpg" alt="Dr Josh chatting with a new patient during their consultation" label="Consultation photo" eager />
      </div>
    </div>
    </div>
  </section>

  <!-- VIDEO -->
  <section class="section">
    <div class="container">
      <div class="center narrow">
        <h2>What we look at in your assessment</h2>
      </div>
      <div style="max-width:880px;margin:28px auto 0">
        <Video file={site.videos.offer} vertical title="Dr Josh explains the three technologies we use in your assessment" />
      </div>
    </div>
  </section>

  <!-- DIFFERENCE -->
  <section class="section">
    <div class="container split">
      <div>
        <span class="eyebrow">Why we’re different</span>
        <h2>We don’t guess. We measure.</h2>
        <p>Most people spend months, even years, trying to manage their pain with stretching, massage, new pillows or new routines. It helps for a while, then it comes back, because the underlying pattern was never measured, let alone corrected.</p>
        <p>Your assessment starts with a <strong>Thermpix thermography scan</strong>, thermal imaging with AI-assisted analysis that identifies hotspots along your spine. Combined with a thorough exam and in-house X-ray if needed, it gives us a clear picture of which areas need correcting and why.</p>
        <p>Then, at your report of findings, we explain exactly what’s going on and the path to fixing it for the long term.</p>
      </div>
      <Media src="/images/thermography-scan.jpg" alt="Thermography scan example" label="Thermpix scan image (de-identified)" />
    </div>
  </section>

  <!-- STEPS -->
  <section class="section section--mint panel">
    <div class="container narrow">
      <h2 class="center">How it works</h2>
      <div class="steps" style="margin-top:28px">
        <div class="step"><h3>Leave your details</h3><p>It takes 30 seconds. Our team will call you, usually the same or next business day.</p></div>
        <div class="step"><h3>Your assessment</h3><p>History, thermography scan, spinal and neurological assessment, and X-rays in-house if required.</p></div>
        <div class="step"><h3>Your report of findings</h3><p>Clear answers about what’s going on, and a plan to correct it for the long term.</p></div>
      </div>
      <div class="center" style="margin-top:28px">
        <a class="btn btn--primary" href="#claim">Claim My {offer.price} Assessment</a>
      </div>
      <p class="fine-print center" style="margin-top:24px">
        {offer.price} {offer.name} is for new patients only. Care recommendations and any further visits are discussed at
        your report of findings. Individual results vary.
      </p>
    </div>
  </section>


  <!-- CLAIM POP-UP -->
  <dialog class="lp-dialog" id="claim" aria-labelledby="claim-title">
    <div class="card lp-form">
      <button class="lp-dialog__close" type="button" data-close aria-label="Close">×</button>
        <h2 id="claim-title">Claim your {offer.price} assessment</h2>
        <p class="fine-print" style="margin-top:-6px">Leave your details and we’ll call to make sure we can help.</p>
        <form
          class="form"
          name="offer-lead"
          method="POST"
          action="/offer/thank-you"
          data-netlify="true"
          netlify-honeypot="company"
          id="lead-form"
        >
          <input type="hidden" name="form-name" value="offer-lead" />
          <p class="hidden"><label>Don’t fill this in: <input name="company" /></label></p>
          <div class="form-row">
            <label>First name<input name="first_name" autocomplete="given-name" required /></label>
            <label>Last name<input name="last_name" autocomplete="family-name" required /></label>
          </div>
          <label>Email<input name="email" type="email" autocomplete="email" required /></label>
          <label>Mobile<input name="phone" type="tel" autocomplete="tel" inputmode="tel" required /></label>
          <label>What made you interested in this offer?<textarea name="reason" rows="3" required></textarea></label>
          <label>Do you work, live or will travel to Yandina?
            <select name="travel" required>
              <option value="">Select…</option>
              <option>I am a Yandina local</option>
              <option>Yes, I am happy to travel</option>
              <option>Not sure, depends on the time</option>
              <option>No</option>
            </select>
          </label>
          <label>Your suburb<input name="suburb" autocomplete="address-level2" placeholder="e.g. Yandina" required /></label>
          <label class="check"><input type="checkbox" name="marketing_consent" value="yes" /> <span>Send me occasional health tips and clinic offers by email or SMS. You can unsubscribe at any time.</span></label>
          <input type="hidden" name="utm_source" />
          <input type="hidden" name="utm_campaign" />
          <input type="hidden" name="utm_medium" />
          <input type="hidden" name="utm_content" />
          <input type="hidden" name="utm_term" />
          <input type="hidden" name="fbclid" />
          <input type="hidden" name="gclid" />
          <button class="btn btn--primary btn--block" type="submit">Claim My {offer.price} Assessment</button>
          <p class="fine-print">By submitting you agree to be contacted by our team about your appointment. See our <a href="/privacy">privacy policy</a>.</p>
        </form>
    </div>
  </dialog>

  <a class="lp-sticky btn btn--primary" href="#claim">Claim {offer.price} Assessment</a>
</Base>

<script is:inline define:vars={{ sheetWebhook: offer.sheetWebhook }}>
  (function () {
    var form = document.getElementById('lead-form');
    if (!form) return;
    var dlg = document.getElementById('claim');
    function openClaim() {
      if (!dlg) return;
      if (dlg.showModal) dlg.showModal(); else dlg.setAttribute('open', '');
      if (window.fbq) window.fbq('track', 'InitiateCheckout', { content_name: 'Offer form opened' });
      setTimeout(function () { var f = form.querySelector('input[name="first_name"]'); if (f && innerWidth > 700) f.focus(); }, 50);
    }
    function closeClaim() { if (dlg.close) dlg.close(); else dlg.removeAttribute('open'); }
    dlg.querySelector('[data-close]').addEventListener('click', closeClaim);
    dlg.addEventListener('click', function (e) { if (e.target === dlg) closeClaim(); }); // tap outside
    document.querySelectorAll('a[href="#claim"]').forEach(function (a) {
      a.addEventListener('click', function (e) { e.preventDefault(); openClaim(); });
    });

    // Swipe-to-claim: drag the price knob to the end (or tap / press Enter)
    var sw = document.querySelector('[data-swipe]');
    if (sw) {
      var knob = sw.querySelector('.swipe__knob'), fill = sw.querySelector('.swipe__fill'), txt = sw.querySelector('.swipe__text');
      var startX = 0, x = 0, max = 0, dragging = false, moved = false;
      var set = function (v, anim) {
        x = Math.max(0, Math.min(max, v));
        knob.style.transition = fill.style.transition = anim ? 'transform .3s, width .3s' : 'none';
        knob.style.transform = 'translateX(' + x + 'px)';
        fill.style.width = (x + knob.offsetWidth + 6) + 'px';
        txt.style.transition = knob.style.transition;
        txt.style.opacity = max ? String(Math.max(0, 1 - x / (max * 0.7))) : '1';
      };
      var done = function () { set(max, true); setTimeout(function () { openClaim(); set(0, true); }, 220); };
      knob.addEventListener('pointerdown', function (e) {
        dragging = true; moved = false; startX = e.clientX - x;
        max = sw.clientWidth - knob.offsetWidth - 12;
        knob.setPointerCapture(e.pointerId);
      });
      knob.addEventListener('pointermove', function (e) {
        if (!dragging) return;
        if (Math.abs(e.clientX - startX - x) > 3) moved = true;
        set(e.clientX - startX);
      });
      var end = function () {
        if (!dragging) return; dragging = false;
        if (!moved || x > max * 0.6) done(); else set(0, true);
      };
      knob.addEventListener('pointerup', end);
      knob.addEventListener('pointercancel', function () { dragging = false; set(0, true); });
      sw.addEventListener('click', function (e) { if (!knob.contains(e.target)) { max = sw.clientWidth - knob.offsetWidth - 12; done(); } });
      sw.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); max = sw.clientWidth - knob.offsetWidth - 12; done(); } });
    }

    // Carry ad tracking (utm_*) into the lead
    var params = new URLSearchParams(location.search);
    ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid', 'gclid'].forEach(function (k) {
      var el = form.querySelector('[name="' + k + '"]');
      if (el && params.get(k)) el.value = params.get(k);
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var btn = form.querySelector('button[type=submit]');
      btn.disabled = true; btn.textContent = 'Sending…';
      var body = new URLSearchParams(new FormData(form)).toString();
      var jobs = [
        fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body }),
      ];
      if (sheetWebhook) {
        jobs.push(fetch(sheetWebhook, { method: 'POST', mode: 'no-cors', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body }));
      }
      Promise.allSettled(jobs).then(function () {
        if (window.fbq) window.fbq('track', 'Lead');
        location.href = '/offer/thank-you';
      });
    });
  })();
</script>

<style>
  .lp-hero { padding-top: 12px; }
  .lp-hero__panel { background: radial-gradient(60% 80% at 100% 0%, rgba(255,255,255,.7), transparent 60%), radial-gradient(50% 70% at 0% 100%, rgba(207,227,194,.45), transparent 60%), var(--sand); padding: clamp(40px, 6vw, 88px) 0; }
  .lp-copy h1 { font-size: clamp(2.3rem, 5vw, 3.8rem); }
  .lp-form { box-shadow: var(--shadow); border: 0; }
  .lp-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(24px, 4vw, 56px); align-items: start; }
  .lp-form h2 { font-size: 1.6rem; }
  .lp-photo { max-width: 540px; justify-self: end; width: 100%; align-self: center; }
  .swipe { position: relative; display: flex; align-items: center; width: min(100%, 420px); height: 68px; margin: 6px 0 26px; padding: 6px; border-radius: 999px; background: var(--white); border: 1px solid var(--line); box-shadow: var(--shadow-sm); cursor: pointer; user-select: none; -webkit-user-select: none; touch-action: pan-y; overflow: hidden; }
  .swipe:focus-visible { outline: 3px solid var(--brand); outline-offset: 3px; }
  .swipe__fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; border-radius: 999px; background: rgba(108,179,80,.18); }
  .swipe__knob { position: relative; z-index: 2; flex: none; height: 56px; min-width: 92px; padding: 0 18px; display: grid; place-items: center; border-radius: 999px; background: var(--accent); color: var(--ink); font-family: var(--font-head); font-size: 1.6rem; font-weight: 800; letter-spacing: -0.03em; cursor: grab; touch-action: none; box-shadow: 0 6px 18px -6px rgba(77,127,59,.6); }
  .swipe__knob:active { cursor: grabbing; }
  .swipe__text { position: absolute; left: 112px; right: 16px; z-index: 1; display: grid; line-height: 1.2; pointer-events: none; }
  .swipe__text strong { color: var(--ink); font-size: .98rem; }
  .swipe__text small { color: var(--brand); font-weight: 700; font-size: .8rem; letter-spacing: .04em; animation: swipe-hint 2.2s ease-in-out infinite; }
  @keyframes swipe-hint { 0%, 100% { transform: translateX(0); opacity: .75; } 50% { transform: translateX(6px); opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .swipe__text small { animation: none; } }
  .lp-dialog { border: 0; padding: 0; background: transparent; width: min(560px, calc(100% - 24px)); max-height: calc(100dvh - 24px); overflow: visible; }
  .lp-dialog::backdrop { background: rgba(43,39,35,.55); backdrop-filter: blur(3px); }
  .lp-dialog .lp-form { position: relative; max-height: calc(100dvh - 24px); overflow-y: auto; padding-top: 28px; }
  .lp-dialog h2 { padding-right: 44px; }
  .lp-dialog__close { position: absolute; top: 10px; right: 12px; width: 40px; height: 40px; border-radius: 50%; border: 0; background: var(--sand); color: var(--ink); font-size: 1.6rem; line-height: 1; cursor: pointer; }
  :global(html:has(dialog[open])) { overflow: hidden; }
  .lp-sticky { display: none; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .check { display: flex !important; gap: 10px; align-items: flex-start; font-weight: 500; font-size: .9rem; }
  .check input { width: auto; margin-top: 4px; flex: none; }
  @media (max-width: 420px) { .form-row { grid-template-columns: 1fr; } }
  @media (max-width: 900px) {
    .lp-grid { grid-template-columns: 1fr; }
    .lp-photo { justify-self: center; max-width: 420px; }
    .lp-sticky { display: flex; position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 40; }
  }
</style>
