---
import Base from '../../layouts/Base.astro';
import SwipeCall from '../../components/SwipeCall.astro';
---
<Base noindex title="You’re subscribed">
  <section class="section">
    <div class="container narrow center">
      <span class="eyebrow">You’re subscribed</span>
      <h1>Thanks! Watch your inbox.</h1>
      <p class="lead">You’ll get our next article in your inbox. You can unsubscribe any time from the link in each email.</p>
      <div class="btn-row" style="justify-content:center;margin-top:28px">
        <a class="btn btn--glass" href="/blog">Back to the Education Centre</a>
        <a class="btn btn--primary" href="/book-online-yandina" data-book>Book online</a>
        <SwipeCall />
      </div>
    </div>
  </section>
</Base>
