---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Media from '../../components/Media.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import Icon from '../../components/Icon.astro';
import { publishedPosts, formatDate } from '../../utils/posts';

const posts = await publishedPosts();
const [latest, ...rest] = posts;
---
<Base title="Chiropractic & Health Blog, Sunshine Coast" crumb="Blog" description="Practical health tips from the chiropractors at The Balanced Chiropractic Centre in Yandina: back and neck pain, posture, headaches, stress, kids and staying active.">
  <PageHero eyebrow="Blog" title="Health tips from <span class='hl'>your Yandina chiropractors.</span>" lead="Practical, down-to-earth articles on posture, pain, stress and staying active. A new post every fortnight." />

  <section class="section">
    <div class="container">
      {latest && (
        <a class="feature reveal" href={`/blog/${latest.id}/`}>
          <Media src={latest.data.image} alt={latest.data.imageAlt} shape="wide" />
          <div>
            <span class="meta">Latest · {formatDate(latest.data.date)}</span>
            <h2>{latest.data.title}</h2>
            <p>{latest.data.description}</p>
            <span class="more">Read article<Icon name="arrow" /></span>
          </div>
        </a>
      )}
      <div class="grid grid-3 posts">
        {rest.map((p, i) => (
          <a class={`card card--hover post reveal reveal-delay-${i % 3}`} href={`/blog/${p.id}/`}>
            <Media src={p.data.image} alt={p.data.imageAlt} shape="wide" />
            <span class="meta">{formatDate(p.data.date)}</span>
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container"><NewsletterSignup /></div>
  </section>
</Base>
<style>
  .feature { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(24px, 4vw, 56px); align-items: center; text-decoration: none; color: inherit; margin-bottom: clamp(40px, 6vw, 72px); }
  .feature h2 { margin: 10px 0 .4em; }
  .feature:hover h2 { color: var(--brand); }
  .meta { font-size: .78rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--brand); }
  .more { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; color: var(--brand); }
  .more :global(svg) { width: 16px; height: 16px; }
  .post { text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 10px; padding: 14px 14px 24px; }
  .post :global(.media) { border-radius: 16px; margin-bottom: 6px; }
  .post h3, .post p, .post .meta { padding: 0 8px; margin: 0; }
  .post p { font-size: .95rem; color: var(--muted); }
  @media (max-width: 860px) { .feature { grid-template-columns: 1fr; } }
</style>
