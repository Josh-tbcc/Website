---
import '../styles/global.css';
import { site, team } from '../config/site';
import { conditions } from '../config/conditions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBookBar from '../components/MobileBookBar.astro';
import CallbackDialog from '../components/CallbackDialog.astro';

interface Props {
  title?: string;
  description?: string;
  /** Landing-page mode: no main nav or footer links, so ad traffic stays focused */
  landing?: boolean;
  noindex?: boolean;
  /** Header floats transparently over a full-bleed hero */
  overlayHeader?: boolean;
  /** Share image for Facebook/Google (path under /public) */
  image?: string;
  /** Extra structured data for this page (FAQ, people, etc.) */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Short page name for the breadcrumb trail (defaults to title) */
  crumb?: string;
}
const { title, description = site.description, landing = false, noindex = false, overlayHeader = false, image = '/images/hero.jpg', crumb } = Astro.props;
// Keep titles short enough that Google shows them in full (~60 characters)
// (falls back to the short name, then to no brand at all, so the keywords stay visible)
const fullTitle = !title
  ? `Chiropractor Yandina & Surrounding Suburbs | ${site.shortName}`
  : title.length + site.name.length + 3 <= 62 ? `${title} | ${site.name}`
  : title.length + site.shortName.length + 3 <= 62 ? `${title} | ${site.shortName}`
  : title;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
const a = site.address;
const g = site.google;
const gtagIds = [g.analyticsId, ...g.adsIds].filter(Boolean);

// "7:00am – 10:00am, 2:30pm – 6:00pm" -> [['07:00','10:00'], ['14:30','18:00']]
const to24 = (t: string) => {
  const m = t.trim().match(/^(\d{1,2}):(\d{2})(am|pm)$/i);
  if (!m) return null;
  let h = +m[1] % 12; if (m[3].toLowerCase() === 'pm') h += 12;
  return `${String(h).padStart(2, '0')}:${m[2]}`;
};
const openingHours = site.hours.flatMap((h) =>
  h.time.split(',').map((range) => range.split(/[–-]/).map(to24))
    .filter((r) => r.length === 2 && r[0] && r[1])
    .map(([opens, closes]) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.days, opens, closes })),
);

const clinicId = `${site.url}/#clinic`;
const schema: Record<string, unknown>[] = [{
  '@context': 'https://schema.org',
  '@type': 'Chiropractic',
  '@id': clinicId,
  name: site.name,
  description: site.description,
  url: site.url,
  telephone: site.phone,
  email: site.email,
  priceRange: '$$',
  image: `${site.url}/images/hero.jpg`,
  logo: `${site.url}/images/icon.png`,
  openingHoursSpecification: openingHours,
  alternateName: ['Balanced Chiro', 'The Balanced Chiro', 'Balanced Chiropractic Yandina'],
  isAcceptingNewPatients: true,
  currenciesAccepted: 'AUD',
  founder: { '@id': `${site.url}/#dr-joshua-kassis` },
  employee: team.map((m, i) => ({
    '@type': 'Person',
    ...(i === 0 ? { '@id': `${site.url}/#dr-joshua-kassis` } : {}),
    name: m.name, jobTitle: 'Chiropractor', image: `${site.url}${m.photo}`,
    url: `${site.url}${m.page ?? '/about'}`,
    hasCredential: { '@type': 'EducationalOccupationalCredential', name: m.credentials, credentialCategory: 'degree' },
  })),
  knowsAbout: ['Chiropractic', ...conditions.map((c) => c.name), 'Thermography', 'Spinal X-ray', 'Posture'],
  availableService: [
    ...conditions.map((c) => ({ '@type': 'MedicalTherapy', name: `Chiropractic care for ${c.name.toLowerCase()}`, url: `${site.url}/${c.slug}` })),
    { '@type': 'MedicalTest', name: 'Thermpix thermography (thermal nerve) scan', url: `${site.url}/thermography` },
    { '@type': 'MedicalTest', name: 'In-house spinal X-ray (when clinically required)', url: `${site.url}/in-house-x-ray` },
  ],
  potentialAction: { '@type': 'ReserveAction', name: 'Book an appointment', target: `${site.url}/book-online-yandina` },
  address: { '@type': 'PostalAddress', streetAddress: a.street, addressLocality: a.suburb, addressRegion: a.state, postalCode: a.postcode, addressCountry: 'AU' },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: site.mapsUrl,
  sameAs: [site.social.facebook, site.social.instagram, site.mapsUrl].filter(Boolean),
  areaServed: site.areaServed.map((name) => ({ '@type': 'Place', name })),
}];
if (Astro.url.pathname === '/') {
  schema.push({ '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url, name: site.name, publisher: { '@id': clinicId }, inLanguage: 'en-AU' });
} else if (title && !noindex) {
  schema.push({
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: crumb ?? title, item: canonical },
    ],
  });
}
const extra = Astro.props.schema;
if (extra) schema.push(...(Array.isArray(extra) ? extra : [extra]).map((x) => ({ '@context': 'https://schema.org', ...x })));
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f1e9dd" />
    <meta name="geo.region" content="AU-QLD" />
    <meta name="geo.placename" content={`${a.suburb}, Sunshine Coast`} />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="alternate" type="application/rss+xml" title="The Balanced Chiropractic Centre Blog" href="/blog/rss.xml" />
    <slot name="head" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    {schema.map((sd) => <script type="application/ld+json" set:html={JSON.stringify(sd)} />)}

    {site.metaPixelId && (
      <script is:inline define:vars={{ pixelId: site.metaPixelId }}>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
        document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId); fbq('track', 'PageView');
      </script>
    )}
    {g.siteVerification && <meta name="google-site-verification" content={g.siteVerification} />}
    {gtagIds.length > 0 && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gtagIds[0]}`}></script>
        <script is:inline define:vars={{ ids: gtagIds, conv: g.conversions, phone: site.phone }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          ids.forEach(function (id) { gtag('config', id); });
          if (conv.phoneCalls) gtag('config', conv.phoneCalls, { phone_conversion_number: phone });
          document.addEventListener('click', function (e) {
            var a = e.target.closest && e.target.closest('a[href^="tel:"]');
            if (a && conv.phoneClick) gtag('event', 'conversion', { send_to: conv.phoneClick });
          });
        </script>
      </>
    )}
  </head>
  <body>
    {site.metaPixelId && (
      <noscript><img height="1" width="1" style="display:none" alt="" src={`https://www.facebook.com/tr?id=${site.metaPixelId}&ev=PageView&noscript=1`} /></noscript>
    )}
    {landing ? (
      <header class="landing-header">
        <div class="container"><strong>{site.name}</strong><span>{a.suburb}, Sunshine Coast</span></div>
      </header>
    ) : <Header overlay={overlayHeader} />}
    <main>
      <slot />
    </main>
    {landing ? (
      <footer class="landing-footer"><div class="container">
        <p>{site.name} · {a.street}, {a.suburb} {a.state} {a.postcode} · <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a> · <a href="/privacy">Privacy</a></p>
        <p>This site is not part of Facebook or Meta Platforms, Inc. Individual results vary.</p>
      </div></footer>
    ) : (
      <>
        <Footer />
        <MobileBookBar />
        <CallbackDialog />
      </>
    )}

    <script is:inline>
      // Fade sections in as they scroll into view
      (function () {
        var els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) { els.forEach(function (el) { el.classList.add('is-in'); }); return; }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach(function (el) { io.observe(el); });
      })();
      // Tell Meta when someone heads to booking
      document.addEventListener('click', function (e) {
        var el = e.target.closest && e.target.closest('[data-book]');
        if (el && window.fbq) window.fbq('track', 'Schedule');
      });
    </script>
    <style>
      .landing-header { background: var(--sand); color: var(--ink); padding: 14px 0; font-family: var(--font-head); }
      .landing-header .container { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: .92rem; }
      .landing-header span { color: var(--brand); }
      .landing-footer { background: var(--cream); color: var(--muted); padding: 28px 0; font-size: .8rem; text-align: center; border-top: 1px solid var(--line); }
      .landing-footer a { color: var(--ink); }
    </style>
  </body>
</html>
