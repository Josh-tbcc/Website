---
import '../styles/global.css';
import { site } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBookBar from '../components/MobileBookBar.astro';

interface Props {
  title?: string;
  description?: string;
  /** Landing-page mode: no main nav or footer links, so ad traffic stays focused */
  landing?: boolean;
  noindex?: boolean;
}
const { title, description = site.description, landing = false, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Chiropractor Yandina, Sunshine Coast`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const a = site.address;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Chiropractic',
  name: site.name,
  url: site.url,
  telephone: site.phone,
  address: { '@type': 'PostalAddress', streetAddress: a.street, addressLocality: a.suburb, addressRegion: a.state, postalCode: a.postcode, addressCountry: 'AU' },
  areaServed: ['Yandina', 'Sunshine Coast', 'Nambour', 'Coolum Beach', 'Eumundi', 'Maleny', 'Peregian Beach'],
};
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/images/og-image.jpg`} />
    <meta name="theme-color" content="#16323a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    {site.metaPixelId && (
      <script is:inline define:vars={{ pixelId: site.metaPixelId }}>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
        document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId); fbq('track', 'PageView');
      </script>
    )}
    {site.googleAnalyticsId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.googleAnalyticsId}`}></script>
        <script is:inline define:vars={{ gaId: site.googleAnalyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date()); gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body>
    {landing ? (
      <header class="landing-header">
        <div class="container"><strong>{site.name}</strong><span>{a.suburb}, Sunshine Coast</span></div>
      </header>
    ) : <Header />}
    <main>
      <slot />
    </main>
    {landing ? (
      <footer class="landing-footer"><div class="container">
        <p>{site.name} · {a.street}, {a.suburb} {a.state} {a.postcode} · <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a> · <a href="/privacy">Privacy</a></p>
        <p>This site is not part of Facebook or Meta Platforms, Inc. Individual results vary.</p>
      </div></footer>
    ) : (
      <>
        <Footer />
        <MobileBookBar />
      </>
    )}

    <script is:inline>
      // Tell Meta when someone heads to booking
      document.addEventListener('click', function (e) {
        var el = e.target.closest && e.target.closest('[data-book]');
        if (el && window.fbq) window.fbq('track', 'Schedule');
      });
    </script>
    <style>
      .landing-header { background: var(--ink); color: var(--white); padding: 14px 0; }
      .landing-header .container { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: .95rem; }
      .landing-header span { color: #9fc3c6; }
      .landing-footer { background: #0f2429; color: #8aa3a6; padding: 28px 0; font-size: .8rem; text-align: center; }
      .landing-footer a { color: #d9ecee; }
    </style>
  </body>
</html>
