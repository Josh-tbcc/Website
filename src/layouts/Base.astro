---
import '../styles/global.css';
import { site } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBookBar from '../components/MobileBookBar.astro';

interface Props {
  title?: string;
  description?: string;
  /** Landing-page mode: no main nav or footer links, so ad traffic stays focused */
  landing?: boolean;
  noindex?: boolean;
  /** Header floats transparently over a full-bleed hero */
  overlayHeader?: boolean;
}
const { title, description = site.description, landing = false, noindex = false, overlayHeader = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Chiropractor Yandina, Sunshine Coast`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const a = site.address;
const g = site.google;
const gtagIds = [g.analyticsId, ...g.adsIds].filter(Boolean);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Chiropractic',
  name: site.name,
  url: site.url,
  telephone: site.phone,
  image: `${site.url}/images/hero.jpg`,
  logo: `${site.url}/images/icon.png`,
  address: { '@type': 'PostalAddress', streetAddress: a.street, addressLocality: a.suburb, addressRegion: a.state, postalCode: a.postcode, addressCountry: 'AU' },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: site.mapsUrl,
  sameAs: [site.social.facebook, site.social.instagram, site.mapsUrl].filter(Boolean),
  areaServed: ['Yandina', 'Sunshine Coast', 'Nambour', 'Coolum Beach', 'Eumundi', 'Maleny', 'Peregian Beach'],
};
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/images/hero.jpg`} />
    <meta name="theme-color" content="#f1e9dd" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    {site.metaPixelId && (
      <script is:inline define:vars={{ pixelId: site.metaPixelId }}>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
        document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId); fbq('track', 'PageView');
      </script>
    )}
    {g.siteVerification && <meta name="google-site-verification" content={g.siteVerification} />}
    {gtagIds.length > 0 && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gtagIds[0]}`}></script>
        <script is:inline define:vars={{ ids: gtagIds, conv: g.conversions, phone: site.phone }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          ids.forEach(function (id) { gtag('config', id); });
          if (conv.phoneCalls) gtag('config', conv.phoneCalls, { phone_conversion_number: phone });
          document.addEventListener('click', function (e) {
            var a = e.target.closest && e.target.closest('a[href^="tel:"]');
            if (a && conv.phoneClick) gtag('event', 'conversion', { send_to: conv.phoneClick });
          });
        </script>
      </>
    )}
  </head>
  <body>
    {site.metaPixelId && (
      <noscript><img height="1" width="1" style="display:none" alt="" src={`https://www.facebook.com/tr?id=${site.metaPixelId}&ev=PageView&noscript=1`} /></noscript>
    )}
    {landing ? (
      <header class="landing-header">
        <div class="container"><strong>{site.name}</strong><span>{a.suburb}, Sunshine Coast</span></div>
      </header>
    ) : <Header overlay={overlayHeader} />}
    <main>
      <slot />
    </main>
    {landing ? (
      <footer class="landing-footer"><div class="container">
        <p>{site.name} · {a.street}, {a.suburb} {a.state} {a.postcode} · <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a> · <a href="/privacy">Privacy</a></p>
        <p>This site is not part of Facebook or Meta Platforms, Inc. Individual results vary.</p>
      </div></footer>
    ) : (
      <>
        <Footer />
        <MobileBookBar />
      </>
    )}

    <script is:inline>
      // Fade sections in as they scroll into view
      (function () {
        var els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) { els.forEach(function (el) { el.classList.add('is-in'); }); return; }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach(function (el) { io.observe(el); });
      })();
      // Tell Meta when someone heads to booking
      document.addEventListener('click', function (e) {
        var el = e.target.closest && e.target.closest('[data-book]');
        if (el && window.fbq) window.fbq('track', 'Schedule');
      });
    </script>
    <style>
      .landing-header { background: var(--sand); color: var(--ink); padding: 14px 0; font-family: var(--font-head); }
      .landing-header .container { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: .92rem; }
      .landing-header span { color: var(--brand); }
      .landing-footer { background: var(--cream); color: var(--muted); padding: 28px 0; font-size: .8rem; text-align: center; border-top: 1px solid var(--line); }
      .landing-footer a { color: var(--ink); }
    </style>
  </body>
</html>
